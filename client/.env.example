# Browser requests stay same-origin. Only the Astro server reads these values.
SMM_API_BASE_URL=http://127.0.0.1:3001
SMM_API_AUDIENCE=smm-orchestrator-api

# Better Auth uses the same PostgreSQL database as the orchestration backend.
DATABASE_URL=postgresql://smm:smm@localhost:5432/smm
DATABASE_POOL_MAX=5
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Generate a unique value of at least 32 characters; never expose it as PUBLIC_*.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:4321
# Optional comma-separated additional exact origins, such as a controlled preview URL.
AUTH_TRUSTED_ORIGINS=

# Optional in development. Configure both values to enable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
