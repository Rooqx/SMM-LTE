---
import AuthShell from "@/components/auth/AuthShell.astro";
import { ForgotPasswordForm } from "@/components/auth/ForgotPasswordForm";
import { UI_COPY } from "@/config/ui-copy";
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="Password recovery">
  <AuthShell eyebrow="Account recovery" subtitle={UI_COPY.auth.recoverySubtitle} title={UI_COPY.auth.recoveryTitle}>
    <ForgotPasswordForm client:load />
  </AuthShell>
</BaseLayout>
