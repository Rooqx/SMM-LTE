---
import AuthShell from "@/components/auth/AuthShell.astro";
import { ResetPasswordForm } from "@/components/auth/ResetPasswordForm";
import { UI_COPY } from "@/config/ui-copy";
import BaseLayout from "@/layouts/BaseLayout.astro";

const token = Astro.url.searchParams.get("token");
---
<BaseLayout title="Reset password">
  <AuthShell eyebrow="Secure password reset" subtitle={UI_COPY.auth.resetSubtitle} title={UI_COPY.auth.resetTitle}>
    <ResetPasswordForm client:load token={token} />
  </AuthShell>
</BaseLayout>
