{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "smm-orchestration-client",
  "compatibility_date": "2026-10-13",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "DEPLOY_TARGET": "cloudflare",
    "SMM_API_AUDIENCE": "smm-orchestrator-api"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "8c3dfcf56d854cc49ad6dba84f38d2c8"
    }
  ]
}
