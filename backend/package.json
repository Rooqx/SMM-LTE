{
  "name": "smm-orchestrator-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker-entry.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "worker": "node dist/worker-entry.js",
    "migrate": "node --import tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "bootstrap": "node --import tsx src/cli/bootstrap.ts",
    "import:legacy": "node --import tsx src/cli/import-legacy.ts",
    "skills:audit": "node --import tsx src/cli/audit-skills.ts",
    "jobs": "node --import tsx src/cli/jobs.ts",
    "eval:release": "vitest run tests/recipes.test.ts tests/registry.test.ts tests/llm-actions.test.ts tests/prompt-compiler.test.ts tests/memory-assembler.test.ts",
    "load:smoke": "node scripts/load-http.mjs",
    "load:soak": "node scripts/load-http.mjs",
    "baseline:provider": "node --import tsx src/cli/benchmark-provider.ts",
    "baseline:plans": "node --import tsx src/cli/capture-query-plans.ts",
    "security:scan": "node scripts/scan-secrets.mjs",
    "test": "vitest run",
    "test:integration": "vitest run tests/database.integration.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.1.0",
    "@fastify/rate-limit": "^11.2.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.6.1",
    "jose": "6.2.12",
    "openai": "^6.7.0",
    "pg": "^8.16.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
