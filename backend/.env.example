NODE_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

DATABASE_URL=postgresql://smm:smm@localhost:5432/smm
DATABASE_POOL_MAX=10
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_STATEMENT_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=35000
DATABASE_LOCK_TIMEOUT_MS=5000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
DATABASE_CONNECTION_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Comma-separated browser origins. Leave empty to disable cross-origin requests.
CORS_ORIGIN=
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
HTTP_BODY_LIMIT_BYTES=524288
HTTP_REQUEST_TIMEOUT_MS=30000
HTTP_MAX_CONCURRENT_REQUESTS=200
# Set only when the API is behind a known, fixed number of trusted proxy hops.
TRUST_PROXY_HOPS=0
# Required in production. Use a separate secret for the Prometheus endpoint.
METRICS_BEARER_TOKEN=
# Fraction of successful content-free stage traces written to structured logs.
# Aggregate metrics always include every observation; errors are always logged.
PERFORMANCE_TRACE_SAMPLE_RATE=0.1
# Server-controlled rollout switch. Disabling this affects only workspaces that
# have not yet selected an interview authority; existing guided sessions resume.
GUIDED_INTAKE_ENABLED=true

# Short-lived Better Auth assertions presented by the Astro BFF.
AUTH_JWKS_URL=http://localhost:4321/api/auth/jwks
AUTH_TOKEN_ISSUER=http://localhost:4321
AUTH_TOKEN_AUDIENCE=smm-orchestrator-api
AUTH_ASSERTION_MAX_AGE_SECONDS=90

# Optional in development, required in production. Resend is the simplest
# hosted option. AUTH_EMAIL_FROM must belong to a domain verified by Resend.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
AUTH_EMAIL_FROM=noreply@example.com
AUTH_EMAIL_TIMEOUT_MS=10000

# Alternative provider-neutral HTTPS gateway. Set EMAIL_PROVIDER=webhook and
# configure both values below instead of RESEND_API_KEY.
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_TOKEN=

# mock is useful for local workflow tests. Use openai for real runs.
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

SKILLS_ROOT=..
WORKER_ID=local-worker
WORKER_POLL_MS=1000
WORKER_MAX_ATTEMPTS=4
WORKER_RECOVERY_INTERVAL_MS=60000
WORKER_CONCURRENCY=4
WORKER_MODEL_CONCURRENCY=2
WORKER_MAX_CONCURRENT_JOBS_PER_ORGANIZATION=2
WORKER_LEASE_SECONDS=180
WORKER_LEASE_RENEW_MS=30000
WORKER_SHUTDOWN_GRACE_MS=330000
QUEUE_MAX_ACTIVE_JOBS=10000
QUEUE_MAX_ACTIVE_JOBS_PER_ORGANIZATION=20
MAX_ORGANIZATION_MODEL_TOKENS_PER_DAY=2000000
MAX_ORGANIZATION_ESTIMATED_COST_MICRO_USD_PER_DAY=5000000
OPENAI_TIMEOUT_MS=90000
OPENAI_MAX_RETRIES=1
OPENAI_MAX_OUTPUT_TOKENS=12000
# Interview suggestions use the same OPENAI_MODEL as main content generation.
# Their independent timeout and token/cost bounds keep the interaction fast.
OPTION_ASSISTANT_TIMEOUT_MS=5000
OPTION_ASSISTANT_CACHE_TTL_MS=86400000
# Optional, verified price telemetry for the configured option model.
OPTION_ASSISTANT_INPUT_COST_MICRO_USD_PER_MILLION=0
OPTION_ASSISTANT_OUTPUT_COST_MICRO_USD_PER_MILLION=0
MAX_CONTEXT_CHARS=120000
MEMORY_CONTEXT_MAX_CHARS=60000
MEMORY_CONVERSATION_MAX_CHARS=30000
MEMORY_RECENT_MESSAGES=20
MAX_MODEL_ACTIONS_PER_RUN=4
# Multi-action creative runs may first fetch an approved source artifact and
# then generate a complete batch. Keep this bounded above that legitimate path.
MAX_MODEL_TOKENS_PER_RUN=120000
MAX_RUN_DURATION_MS=300000
MAX_OPTIONAL_SKILL_DEPTH=1
MAX_TOOL_RESULT_BYTES=30000
# Optional cost telemetry. Values are micro-US dollars per one million tokens;
# keep zero when the active provider/model price is not configured and verified.
MODEL_INPUT_COST_MICRO_USD_PER_MILLION=0
MODEL_OUTPUT_COST_MICRO_USD_PER_MILLION=0

# Optional. For a locally mounted Obsidian vault, set the directory where exports may be written.
OBSIDIAN_EXPORT_ROOT=
OBSIDIAN_MAX_EXPORT_FILES=5000
OBSIDIAN_MAX_EXPORT_BYTES=50000000
